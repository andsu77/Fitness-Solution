<%- include("partials/header") %>
<section class="section"><div class="container narrow" style="text-align:center">
<p class="eyebrow">SUA CONTA</p>
<h1>Entrar</h1>
<p class="lead">Entre com sua conta Google para acessar seus treinos salvos de qualquer aparelho.</p>

<div class="card" style="max-width:380px;margin:30px auto;padding:36px;display:grid;gap:16px;justify-items:center">
  <% if (clientId) { %>
    <div id="g_id_onload"
      data-client_id="<%= clientId %>"
      data-context="signin"
      data-ux_mode="redirect"
      data-login_uri="/auth/google/callback"
      data-auto_prompt="false">
    </div>
    <div class="g_id_signin" data-type="standard" data-shape="rectangular" data-theme="outline" data-text="signin_with" data-size="large" data-logo_alignment="left"></div>
    <% if (typeof error !== "undefined" && error) { %>
      <p class="builder-save-msg error">Não foi possível entrar com o Google. Tente novamente.</p>
    <% } %>
  <% } else { %>
    <div class="notice">O login com Google ainda não foi configurado neste site. Configure <code>GOOGLE_CLIENT_ID</code> no <code>.env</code> do servidor.</div>
  <% } %>
</div>

<p style="color:#8a939a;font-size:13px">Prefere não entrar? Você ainda pode <a href="/montar-treino">montar treinos</a> e salvá-los neste navegador.</p>
</div></section>

<% if (clientId) { %>
<script src="https://accounts.google.com/gsi/client" async defer></script>
<% } %>
<%- include("partials/footer") %>
