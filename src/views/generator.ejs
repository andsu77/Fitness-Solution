<%- include("partials/header") %><section class="section"><div class="container narrow"><p class="eyebrow">PERSONALIZAÇÃO</p><h1>Monte sua sugestão de treino</h1><p class="lead">Informe sua realidade e veja uma estrutura inicial.</p><form class="card form" method="POST" action="/gerador-de-treino"><label>Objetivo<select name="objective"><option>Hipertrofia</option><option>Emagrecimento</option><option>Força</option></select></label><label>Dias por semana<select name="days"><option value="3">3</option><option value="4">4</option><option value="5">5</option></select></label><label>Tempo por treino<select name="time"><option>30 minutos</option><option>40 minutos</option><option>60 minutos</option></select></label><label>Nível<select name="level"><option>Iniciante</option><option>Intermediário</option><option>Avançado</option></select></label><button class="btn">GERAR SUGESTÃO</button></form><% if(result){ %><div class="card result"><h2>Sua divisão</h2><p><b><%= result.objective %></b> · <%= result.days %> dias · <%= result.time %> · <%= result.level %></p><ol><% result.split.forEach(x => { %><li><%= x %></li><% }) %></ol><div class="notice">Isto é uma sugestão educacional e não uma prescrição individual.</div></div><% } %></div></section><%- include("partials/footer") %>