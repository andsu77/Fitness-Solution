<div class="solutionai" id="solutionai">
  <button class="sai-launcher" id="saiToggle" aria-label="Abrir SolutionAI, tira-dúvidas sobre treino e alimentação" aria-expanded="false">
    <span class="sai-launcher-icon">🤖</span>
  </button>
  <div class="sai-panel" id="saiPanel" role="dialog" aria-labelledby="saiTitle" hidden>
    <div class="sai-header">
      <div class="sai-title" id="saiTitle"><span class="sai-dot"></span>SolutionAI</div>
      <button class="sai-close" id="saiClose" aria-label="Fechar chat">✕</button>
    </div>
    <p class="sai-subtitle">Tire dúvidas sobre treino e alimentação. Não substitui orientação profissional.</p>
    <div class="sai-messages" id="saiMessages"></div>
    <form class="sai-form" id="saiForm">
      <input class="sai-input" id="saiInput" type="text" maxlength="500" autocomplete="off" placeholder="Pergunte sobre treino ou alimentação...">
      <button type="submit" class="sai-send" aria-label="Enviar pergunta">➤</button>
    </form>
  </div>
</div>
