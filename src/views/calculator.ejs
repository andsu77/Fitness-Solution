<%- include("partials/header") %><section class="section"><div class="container narrow"><h1><%= title %></h1><div class="calculator card">
<% if(type==="imc"){ %><label>Peso (kg)<input id="weight" type="number" step="0.1"></label><label>Altura (m)<input id="height" type="number" step="0.01"></label><button class="btn" onclick="calcIMC()">CALCULAR</button><div id="result"></div>
<% } else if(type==="protein"){ %><label>Peso (kg)<input id="weight" type="number" step="0.1"></label><label>Fator (g/kg) <input id="factor" type="number" step="0.1" value="1.6"></label><button class="btn" onclick="calcProtein()">CALCULAR</button><div id="result"></div>
<% } else { %><label>Peso (kg)<input id="weight" type="number"></label><label>Altura (cm)<input id="height" type="number"></label><label>Idade<input id="age" type="number"></label><label>Sexo<select id="sex"><option value="m">Masculino</option><option value="f">Feminino</option></select></label><button class="btn" onclick="calcCalories()">CALCULAR</button><div id="result"></div><small>Estimativa baseada em Mifflin-St Jeor; necessidades individuais variam.</small><% } %>
</div></div></section><%- include("partials/footer") %>